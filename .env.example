# Gerada automaticamente por Backend/prepare_demo.py se vazia.
SECRET_KEY=
DATABASE_URL=sqlite:///sentryai-demo.db
# MySQL: mysql+pymysql://usuario:senha@localhost:3306/sentryai
ENV=development
FLASK_DEBUG=0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

OPENAI_API_KEY=
# OPENAI_TOKEN também é aceito por compatibilidade.
AI_PROVIDER=openai
OPENAI_MODEL=gpt-5.6-terra
OPENAI_AUX_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
AI_ALLOWED_MODELS=

RAG_ENABLED=true
RAG_EMBEDDINGS_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Opcionais: Gemini exige requirements-gemini.txt.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLIENT_ID=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
